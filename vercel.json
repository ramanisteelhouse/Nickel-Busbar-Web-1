{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/render.ts": { "includeFiles": "dist/index.html" }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/merchant-feed.xml", "dest": "/api/index" },
    { "src": "/", "dest": "/api/render?path=/" },
    { "handle": "filesystem" },
    { "src": "/products/?", "dest": "/api/render" },
    { "src": "/categories/?", "dest": "/api/render" },
    { "src": "/product/[^/]+/?", "dest": "/api/render" },
    { "src": "/cart/?", "dest": "/api/render?path=/cart" },
    { "src": "/checkout/?", "dest": "/api/render?path=/checkout" },
    { "src": "/login/?", "dest": "/api/render?path=/login" },
    { "src": "/about/?", "dest": "/api/render?path=/about" },
    { "src": "/contact/?", "dest": "/api/render?path=/contact" },
    { "src": "/export-enquiry/?", "dest": "/api/render?path=/export-enquiry" },
    { "src": "/calculator/?", "dest": "/api/render?path=/calculator" },
    { "src": "/blog/?", "dest": "/api/render?path=/blog" },
    { "src": "/blog/Why-99\\.6-Purity-Matters/?", "status": 301, "headers": { "Location": "https://www.nickelbusbar.com/blog/why-nickel-purity-matters" } },
    { "src": "/blog/Manufacturers-Guide/?", "status": 301, "headers": { "Location": "https://www.nickelbusbar.com/blog/sourcing-custom-stamped-nickel-busbars" } },
    { "src": "/blog/Nickel-Strips-for-Electric-Vehicles/?", "status": 301, "headers": { "Location": "https://www.nickelbusbar.com/blog/nickel-strips-for-electric-vehicles" } },
    { "src": "/blog/Nickel-Strip-Manufacturer-for-UK-Battery-Industry/?", "status": 301, "headers": { "Location": "https://www.nickelbusbar.com/blog/nickel-strip-manufacturer-uk-battery-industry" } },
    { "src": "/blog/Pure-Nickel-Strip-vs-Nickel-Plated-Steel-Strip(?::|%3A)-Complete-Comparison/?", "status": 301, "headers": { "Location": "https://www.nickelbusbar.com/blog/pure-nickel-strip-vs-nickel-plated-steel-strip" } },
    { "src": "/blog/[^/]+/?", "dest": "/api/render" },
    { "src": "/h-type-nickel-strip/?", "dest": "/api/render?path=/h-type-nickel-strip" },
    { "src": "/nickel-strip-manufacturer-in-[a-z0-9-]+/?", "dest": "/api/render" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
