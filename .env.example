# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# JWT Secret (use a long random secret, not an API key)
JWT_SECRET=replace_with_a_long_random_secret

# Gemini API Key
GEMINI_API_KEY=

# App URL
APP_URL=http://localhost:5173

# Localization APIs
EXCHANGE_RATE_API_KEY=
IPSTACK_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Enquiry Notifications (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_NOTIFY_EMAILS=you@example.com

# Enquiry Notifications (WhatsApp via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ENQUIRY_NOTIFY_WHATSAPP=whatsapp:+918369724730
