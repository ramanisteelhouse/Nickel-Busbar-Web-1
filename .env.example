# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- Auth ---
JWT_SECRET=
BLOG_ADMIN_API_KEY=

# --- Chatbot ---
# The chatbot at /api/ai/chat answers from site data (products, blog posts, FAQs) already
# in the database — no API key needed.

# --- App ---
APP_URL=http://localhost:5173

# --- Localization APIs ---
EXCHANGE_RATE_API_KEY=
IPSTACK_API_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Analytics ---
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank and no analytics script loads at all.
# Only fires after the visitor accepts cookies (see src/components/Analytics.tsx).
VITE_GA4_MEASUREMENT_ID=

# --- Enquiry Notifications (Email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_NOTIFY_EMAILS=

# --- Enquiry Notifications (WhatsApp via Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ENQUIRY_NOTIFY_WHATSAPP=
